{
  "enabled": true,
  "name": "Check Django Templates",
  "description": "After editing a Django template file (.html in templates/), validates that the template can be loaded without syntax errors using Django's template engine.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "templates/**/*.html"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python .kiro/hooks/check_template.py \"%FILE%\"",
    "timeout": 15
  }
}
